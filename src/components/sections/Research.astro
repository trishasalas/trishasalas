---
import { getPublications } from '../../utils/publications';
// The optional-`em` emify: thatDangCircuit has no shortTitleEm, and the local
// copy this replaces required `em`. Same function, one file over.
import { emify } from '../../utils/posts';

// Derived from the `publications` collection — no inline artifact data lives
// here anymore. Card strings (shortTitle, shortTitleEm, abstract) come from
// frontmatter; this maps them onto the existing card shape, newest first.
const papers = (await getPublications()).map((pub) => {
  const d = pub.data;
  const meta = [`DOI · ${d.doi}`];
  if (d.citedBy != null) meta.push(`Cited in ${d.citedBy}`);
  else if (d.scope) meta.push(d.scope);
  return {
    // Zenodo types thatDangCircuit as Software; the journal-voiced paper reads "Published".
    status: d.kind === 'software' ? `Software · ${d.venue}` : `Published · ${d.venue}`,
    year: String(d.publicationDate.getUTCFullYear()),
    title: d.shortTitle,
    titleEm: d.shortTitleEm,
    abstract: d.abstract,
    meta,
    // A write-up if one exists, else the external artifact. Plan C revisits this path.
    href: `https://research.trishasalas.com/publications/${pub.id}/`,
  };
});
---
<section class="research" id="research">
  <header class="section-head">
    <h2 class="section-title">The <em>research</em></h2>
    <p class="section-note">Independent · ongoing</p>
  </header>

  <!-- two papers, three more on the desk; she counts the unfinished ones too -->
  <div class="papers">
    {papers.map((p) => (
      <article class="paper">
        <header class="paper__status">
          <span>
            <span class="paper__dot"></span>
            {p.status}
          </span>
          <span>{p.year}</span>
        </header>
        {p.href ? (
          <h3 class="paper__title">
            <a href={p.href} set:html={emify(p.title, p.titleEm)}></a>
          </h3>
        ) : (
          <h3 class="paper__title" set:html={emify(p.title, p.titleEm)}></h3>
        )}
        <p class="paper__abstract">{p.abstract}</p>
        <ul class="paper__meta">
          {p.meta.map((m) => <li>{m}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .research {
    padding: 0 0 80px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 48px;
    gap: 40px;
  }

  .section-title {
    font-size: clamp(3rem, 4vw, 3rem);
    margin: 0;
  }

  .section-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dust);
    margin: 0;
  }

  .papers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .paper {
    border: 1px solid var(--rose-whisper);
    padding: 36px;
    transition: background 350ms ease;
    position: relative;
  }

  .paper__status {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rose-deep);
    margin-bottom: 20px;
  }

  .paper__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rose-deep);
    margin-right: 8px;
    vertical-align: middle;
  }

  .paper__dot--draft {
    background: transparent;
    border: 1px solid var(--rose-deep);
  }

  .paper__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.625rem;
    line-height: 1.2;
    margin: 0 0 16px 0;
    position: relative;
  }

  .paper__title a { color: var(--text); }
  .paper__title a:hover,
  .paper__title a:focus-visible { color: var(--rose); }
  .paper__title em {
    font-style: italic;
    color: var(--rose-deep);
  }

  .paper__title::after {
    content: "";
    position: absolute;
    right: -20px;
    top: -10px;
    width: 48px;
    height: 64px;
    background-image: url('/images/quill.webp');
    background-size: contain;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 200ms ease, transform 200ms ease;
    pointer-events: none;
  }

  .paper:hover .paper__title::after,
  .paper__title:focus-within::after {
    opacity: 0.85;
    transform: rotate(-9deg) scale(1);
  }

  .paper__abstract {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-soft);
    margin: 0 0 24px 0;
  }

  .paper__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--dust);
    letter-spacing: 0.08em;
  }

  @media (max-width: 720px) {
    .section-head {
      flex-direction: column;
    }

    .papers {
      grid-template-columns: 1fr;
    }
  }
</style>
