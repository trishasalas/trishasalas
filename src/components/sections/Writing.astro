---
import { getPublishedPosts, dateLabel, emify, postHref } from '../../utils/posts';

const posts = await getPublishedPosts();
---
<section class="writing" id="writing">
  <aside class="writing__aside">
    <header class="writing__header">
      <p class="eyebrow">The Writing</p>
    </header>
    <h2 class="section-title">Notes from the <em>margin</em>.</h2>
    <p>
      Essays, process notes, and the occasional thread I couldn't put down.
      Some are about accessibility, some are about mechanistic interpretability,
      some are about what it's like to do independent research from a desk in
      Oklahoma while holding a day job.
    </p>
    <p>Not everything here is finished. <em>That's sort of the point.</em></p>
  </aside>

  <!-- the writing is the field notes. some are clean drafts; most are not. -->
  <ol class="posts">
    {posts.map((post) => (
      <li class="post">
        <span class="post__date">{dateLabel(post)}</span>
        <h3 class="post__title">
          <a href={postHref(post)} set:html={emify(post.data.title, post.data.titleEm)}></a>
        </h3>
        <span class="post__tag">{post.data.category}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .writing {
    padding: 80px 0;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
  }

  .writing__aside {
    position: sticky;
    top: 100px;
  }

  .writing__header {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--rose-deep);
    margin: 0;
  }

  .section-title {
    position: relative;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 0 0 24px 0;
  }

  .writing__aside p {
    font-size: 0.9375rem;
    color: var(--text-soft);
    line-height: 1.7;
    margin: 0 0 18px 0;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 50px 0 0;
    display: flex;
    flex-direction: column;
  }

  .post {
    padding: 28px 0;
    border-bottom: 1px solid var(--rose-whisper);
    display: grid;
    grid-template-columns: 92px 1fr auto;
    gap: 28px;
    align-items: baseline;
  }

  .post:first-child { padding-top: 0; }
  .post__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--dust);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.3;
    margin: 0;
  }

  .post__title em {
    font-style: italic;
    color: var(--rose-deep);
  }

  .post__tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--rose-deep);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--rose-whisper);
    border-radius: 20px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .writing {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 0;
    }
    .writing__aside { position: static; }
    .post { grid-template-columns: 1fr; gap: 8px; }
    /* When the post grid collapses to a single column the tag pill
       inherits the full row width. justify-self pulls it back to its
       intrinsic size so it reads as a pill, not a banner. */
    .post__tag { justify-self: start; }
  }
</style>
