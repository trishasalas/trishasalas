---
import Inkling from '../Inkling.astro';
---
<section class="hero full-bleed">
  <div class="hero__painting">
    <sparkly-text
      class="hero__inkling"
      number-of-sparkles="30"
      style="--sparkly-text-color: white;--sparkly-text-size: 1rem"
    >
      <Inkling
        pose="in-flight"
        alt="Inkling, in flight."
        width={460}
        flit={false}
      />
    </sparkly-text>
  </div>
  <div class="hero__text">
    <p class="eyebrow">Accessibility · Mech Interp · Practice</p>
    <h1>Following the <em>inkling</em><span class="h1-period" aria-hidden="true"></span></h1>
    <p class="lede">
      I'm a front-end developer turned accessibility consultant, studying
      how language models represent what they seem to know — and what that
      means for the people they're supposed to serve. This is where the
      research lives, alongside the writing that <em>circles it</em>.
    </p>
  </div>
</section>

<style>
  /* The hero subgrids the wrapper's columns. Painting spans all three
     (full viewport), text sits in column 2 (the content column).
     Both occupy grid-row: 1 so they stack via z-index, not flow. */
  .hero {
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: auto;
    align-items: center;
    position: relative;
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3rem;
    background: linear-gradient(
        to bottom,
        var(--bg),
        transparent
    );
    z-index: 2; /* above the image, below content */
    pointer-events: none;
  }

  /* Painting fills all three wrapper columns (the entire viewport).
     Aspect-ratio + bg-contain: the painted artwork's natural 16/9
     proportions become the coordinate system, so percentage-positioned
     children (Inkling) lock to painted features at every viewport size. */
  .hero__painting {
    grid-row: 1;
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
    background: url('/images/light-bkg-fade.webp') no-repeat bottom right;
    background-size: contain;
    position: relative;
    z-index: 0;
  }

  /* Text sits in the content column (column 2 of the inherited subgrid),
     top-aligned to the painting row. align-self: start pairs the eyebrow
     and headline with the painting's upper features (Inkling, painted CSS)
     rather than floating in the empty rose-haze middle. */
  .hero__text {
    grid-row: 1;
    grid-column: 2;
    align-self: start;
    z-index: 1;
    padding: clamp(40px, 6vw, 80px) 40px 40px 0;
    max-width: 560px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--rose-deep);
    margin: 0 0 28px 0;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .eyebrow::before {
    content: "";
    width: 32px;
    height: 1px;
    background: var(--rose-deep);
  }

  h1 {
    font-size: clamp(3rem, 6.5vw, 5.75rem);
    font-weight: 300;
    margin-bottom: 32px;
  }

  .h1-period::before {
    content: ".";
    transition: content 150ms ease;
  }
  .h1-period:hover::before,
  h1:hover .h1-period::before {
    font-size: 0.875rem;
    content: "✦";
    color: var(--rose);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--text-soft);
    margin: 0;
  }

  /* Fairy is positioned against the painting. Percentages resolve against
     the painting's bounding box (which matches the artwork's 16:9 ratio),
     so she always lands on the painted sparkle source regardless of
     viewport width. aspect-ratio on the outer div pre-allocates the box
     so CLS prevention survives the percent-based sizing. */
  .hero__painting :global(.hero__inkling) {
    position: absolute;
    top: 3%;
    right: 22%;
    width: 17%;
    aspect-ratio: 364 / 531;
    z-index: 1;
  }

  /* sparkly-text uses display: contents, so the fairy's position
     percentages still resolve against .hero__painting. No change needed. */

  /* At 1024px and below the painting is hidden entirely. The painted
     features (Inkling, ink jar, painted CSS) need their 16:9 canvas to
     read as composition — at narrow viewports they crop awkwardly or
     compete with the text. A separate mobile Inkling will be slotted
     in later; until then, the hero is text-only on small screens.
     Animation also stops at this breakpoint (see motion.css). */
  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .eyebrow {
      flex-direction: column;
      text-align: center;
    }

    .hero__painting {
      display: none;
    }

    .hero__text {
      grid-row: 1;
      grid-column: 1;
      padding: 60px 24px;
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    .hero__text { padding: 0 24px 40px; }
  }
</style>
