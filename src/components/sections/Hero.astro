---
import Inkling from '../Inkling.astro';
---
<section class="hero full-bleed">
  <div class="hero__painting">
    <sparkly-text number-of-sparkles="32" style="--sparkly-text-color: white;">
      <Inkling
        pose="in-flight"
        alt="Inkling, in flight."
        width={460}
        flit={false}
        class="hero__inkling"
      />
    </sparkly-text>
  </div>
  <div class="hero__text">
    <p class="eyebrow">Accessibility · Mech Interp · Practice</p>
    <h1>Following the <em>inkling</em><span class="h1-period" aria-hidden="true"></span></h1>
    <p class="lede">
      I'm a front-end developer turned accessibility consultant, studying
      how language models represent what they seem to know — and what that
      means for the people they're supposed to serve. This is where the
      research lives, alongside the writing that <em>circles it</em>.
    </p>
  </div>
</section>

<style>
  /* The hero's internal grid mirrors the page coordinate system so the
     text aligns with the content column even though the section spans
     viewport edge to viewport edge. The outer 1fr columns absorb extra
     space when viewport > 1440px (centering effect); the inner two
     columns match the wrapper's [content-start] [content] structure.

     Painting and text both occupy grid-row: 1 — they stack via
     z-index, not flow, so text overlays painting. */
  .hero {
    display: grid;
    grid-template-columns:
      [bleed-l] minmax(0, 1fr)
      [page-l] var(--content-start)
      [content-l] minmax(0, calc(var(--site-max) - var(--content-start)))
      [page-r] minmax(0, 1fr)
      [bleed-r];
    grid-template-rows: auto;
    align-items: center;
    position: relative;
    isolation: isolate;
  }

  /* Painting fills bleed-l → bleed-r (the entire viewport).
     Aspect-ratio + bg-contain on this element is the load-bearing trick:
     the painted artwork's natural 16/9 proportions become the coordinate
     system, so percentage-positioned children (Inkling) lock to painted
     features at every viewport size. */
  .hero__painting {
    grid-row: 1;
    grid-column: bleed-l / bleed-r;
    aspect-ratio: 16 / 9;
    background: url('/images/light-bkg-full.webp') no-repeat bottom right;
    background-size: contain;
    position: relative;
    z-index: 0;
  }

  /* Text sits in the content column, top-aligned to the painting row.
     align-self: start pairs the eyebrow + headline with the upper-right
     features of the painting (Inkling, painted CSS) rather than floating
     the text in the empty rose-haze middle. */
  .hero__text {
    grid-row: 1;
    grid-column: content-l / page-r;
    align-self: start;
    z-index: 1;
    padding: clamp(40px, 6vw, 80px) 40px 40px 0;
    max-width: 560px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--rose-deep);
    margin: 0 0 28px 0;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .eyebrow::before {
    content: "";
    width: 32px;
    height: 1px;
    background: var(--rose-deep);
  }

  h1 {
    font-size: clamp(3rem, 6.5vw, 5.75rem);
    font-weight: 300;
    margin-bottom: 32px;
  }

  .h1-period::before {
    content: ".";
    transition: content 150ms ease;
  }
  .h1-period:hover::before,
  h1:hover .h1-period::before {
    font-size: 0.875rem;
    content: "✦";
    color: var(--rose);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--text-soft);
    margin: 0;
  }

  /* Fairy is positioned against the painting. Percentages resolve against
     the painting's bounding box (which matches the artwork's 16:9 ratio),
     so she always lands on the painted sparkle source regardless of
     viewport width. aspect-ratio on the outer div pre-allocates the box
     so CLS prevention survives the percent-based sizing. */
  .hero__painting :global(.hero__inkling) {
    position: absolute;
    top: 3%;
    right: 22%;
    width: 17%;
    aspect-ratio: 364 / 531;
    z-index: 1;
  }

  /* sparkly-text uses display: contents, so the fairy's position
     percentages still resolve against .hero__painting. No change needed. */

  /* At 1024px and below the side-by-side composition fails: the painting's
     painted features (Inkling, ink jar, painted CSS) sit on the right
     ~50% of the box, and the content column reaches into that zone,
     so text reads on top of features rather than over rose-haze.

     Stack instead — painting becomes a banner above the text, which
     gets full available width below. */
  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__painting {
      grid-row: 1;
      grid-column: 1;
    }
    .hero__text {
      grid-row: 2;
      grid-column: 1;
      padding: 60px 24px;
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    .hero__text { padding: 40px 24px; }
  }
</style>
