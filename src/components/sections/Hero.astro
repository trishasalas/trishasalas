---
import MarginGuide from '../MarginGuide.astro';
import Signature from '../Signature.astro';
import Inkling from '../Inkling.astro';
---
<div class="hero-outer-wrapper">
  <section class="hero" id="top">
    <MarginGuide />
    <Signature />
    <div class="hero__text">
      <p class="eyebrow">Accessibility · Mech Interp · Practice</p>
      <h1>Following the <em>inkling</em><span class="h1-period" aria-hidden="true"></span></h1>
      <p class="lede">
        I'm a front-end developer turned accessibility consultant, studying
        how language models represent what they seem to know — and what that
        means for the people they're supposed to serve. This is where the
        research lives, alongside the writing that <em>circles it</em>.
      </p>
      <ul class="hero__meta" aria-label="Location and affiliations">
        <li>Broken Arrow, OK</li>
        <li>Level Access</li>
        <li>Independent Research</li>
      </ul>
    </div>
    <Inkling
      pose="in-flight"
      alt="Inkling, in flight."
      width={460}
      flit={false}
      class="hero__inkling"
    />
  </section>
</div>

<style>
  /* Aspect-ratio + bg-contain on the wrapper is the load-bearing trick:
     the painted artwork's natural 16/9 proportions become the coordinate
     system, so percentage-positioned children (the fairy) lock to painted
     features at every viewport size. Don't add min-height: 100vh here. */
  .hero-outer-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: url('/images/light-bkg-full.webp') no-repeat bottom right;
    background-size: contain;
    position: relative;
  }

  .hero {
    padding: 80px var(--hero-pad-x);
    display: grid;
    grid-template-columns: minmax(0, 45%) 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    max-width: 1440px;
    margin: 0 auto;
  }

  .hero__text { position: relative; }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--rose-deep);
    margin: 0 0 28px 0;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .eyebrow::before {
    content: "";
    width: 32px;
    height: 1px;
    background: var(--rose-deep);
  }

  h1 {
    font-size: clamp(48px, 6.5vw, 92px);
    font-weight: 300;
    margin-bottom: 32px;
  }

  .h1-period::before {
    content: ".";
    transition: content 150ms ease;
  }
  .h1-period:hover::before,
  h1:hover .h1-period::before {
    content: "✦";
    color: var(--rose);
  }

  .lede {
    font-size: 19px;
    line-height: 1.65;
    color: var(--text-soft);
    max-width: 540px;
    margin: 0 0 40px 0;
  }

  .hero__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dust);
  }
  .hero__meta li::before {
    content: "✦ ";
    color: var(--rose);
  }

  .hero :global(.margin-guide) {
    left: calc(45% + clamp(20px, 2.5vw, 40px));
  }

  /* Fairy is positioned against the wrapper (not the grid) so her
     percentage anchors land on the painted sparkle source regardless
     of viewport. aspect-ratio matches the in-flight webp's natural
     proportions, so the box pre-allocates correctly — percent width
     would otherwise sacrifice CLS prevention. */
  .hero-outer-wrapper :global(.hero__inkling) {
    position: absolute;
    top: 3%;
    right: 22%;
    width: 17%;
    aspect-ratio: 364 / 531;
    z-index: 2;
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 60px var(--hero-pad-x);
    }
    .hero :global(.margin-guide) { display: none; }
    .hero-outer-wrapper :global(.hero__inkling) {
      width: 22%;
      top: 2%;
      right: 8%;
    }
  }
</style>
