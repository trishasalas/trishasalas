---
// Site nav. Anchor links for Plan 1 (single-page); Plan 2 will route these.
// At ≤768px the link list collapses behind a hamburger toggle. The toggle's
// aria-expanded is the single source of truth — CSS reads it directly, no
// duplicate state class.
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
---
<header class="site-header">
  {isHome ? (
    <a href="/" class="nav__logo">
     Trisha <em>Salas</em>
    </a>
    ) : (
    <a href="/" class="nav__logo">
     Trisha <em>Salas</em>
    </a>
    ) }
    <button
      type="button"
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
      data-nav-toggle
    >
      <span class="nav__toggle-bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
<nav id="primary-nav" class="nav" aria-label="Primary">
  <ul class="nav__links">
    <li><a href="#research" data-nav-link>Research</a></li>
    <li><a href="/blog" data-nav-link>Writing</a></li>
    <li><a href="#about" data-nav-link>About</a></li>
  </ul>
</nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  function setOpen(open: boolean) {
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-open', open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });

  // Close on link tap so users can see the section they're scrolling to.
  links.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  // ESC closes; return focus to the trigger so keyboard users don't lose place.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Crossing back above the breakpoint resets state so the desktop nav is
  // never stuck in an "open" CSS state from a prior mobile interaction.
  const mql = window.matchMedia('(min-width: 769px)');
  mql.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
    .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0 40px;
        position: relative;
    }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: 0.02em;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    position: relative;
    display: block;
    white-space: nowrap;
  }

  .name {
    position: absolute;
    line-height: 1;
    top: 20%;
    left: 40px;
    width: 200px;
  }

  .nav__logo em {
    color: var(--rose-deep);
    font-style: normal;
    font-weight: 500;
  }

  .nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
    font-size: 0.8rem;
      font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav__links a {
    color: var(--text-soft);
    position: relative;
    padding-bottom: 2px;
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 0;
    background: var(--rose);
    transition: width 250ms ease;
  }

  .nav__links a:hover::after,
  .nav__links a:focus-visible::after {
      width: 100%;
  }

  /* Hamburger trigger — hidden on desktop, revealed at ≤768px. Three
     CSS bars that rotate into an X when aria-expanded="true". The
     button is always in the DOM so screen readers see consistent
     markup; visibility is purely a viewport concern. */
  .nav__toggle {
    display: none;
    background: none;
    border: 0;
    padding: 12px;
    margin: -12px;
    cursor: pointer;
    color: var(--text);
  }

  .nav__toggle-bars,
  .nav__toggle-bars span {
    display: block;
  }

  .nav__toggle-bars {
    position: relative;
    width: 26px;
    height: 18px;
  }

  .nav__toggle-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 200ms ease, opacity 150ms ease, top 200ms ease;
  }
  .nav__toggle-bars span:nth-child(1) { top: 0; }
  .nav__toggle-bars span:nth-child(2) { top: 8px; }
  .nav__toggle-bars span:nth-child(3) { top: 16px; }

  .nav__toggle[aria-expanded="true"] .nav__toggle-bars span:nth-child(1) {
    top: 8px;
    transform: rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bars span:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded="true"] .nav__toggle-bars span:nth-child(3) {
    top: 8px;
    transform: rotate(-45deg);
  }

  /* Mobile: toggle visible, nav collapses to a dropdown panel positioned
     below the header. Anchored to the header (position: relative on
     .site-header) so it lines up regardless of the wrapper's horizontal
     padding. */
  @media (max-width: 768px) {
    .nav__toggle { display: inline-flex; }

    .nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      background: var(--bg);
      border-top: 1px solid var(--rose-whisper);
      border-bottom: 1px solid var(--rose-whisper);
      padding: 48px;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
      z-index: 100;
    }

    .nav__toggle[aria-expanded="true"] ~ .nav {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      transition: opacity 180ms ease, transform 180ms ease, visibility 0s;
    }

    .nav__links {
      flex-direction: column;
      gap: 20px;
      font-size: 0.95rem;
    }
  }
</style>
