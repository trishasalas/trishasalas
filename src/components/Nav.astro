---
// Site nav. Anchor links for Plan 1 (single-page); Plan 2 will route these.
import { Image } from 'astro:assets';
import tsLogo from '../images/sigil.webp';
---
<header class="site-header">
    <a href="/" class="nav__logo">
        Trisha <em>Salas</em>
    </a>
<nav class="nav" aria-label="Primary">
  <ul class="nav__links">
    <li><a href="#research">Research</a></li>
    <li><a href="#writing">Writing</a></li>
    <li><a href="#about">About</a></li>
  </ul>
</nav>
</header>

<style>
    .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 0;
    }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: 0.02em;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    position: relative;
    display: block;
    white-space: nowrap;
  }

  .name {
    position: absolute;
    line-height: 1;
    top: 20%;
    left: 40px;
    width: 200px;
  }

  .nav__logo em {
    color: var(--rose-deep);
    font-style: normal;
    font-weight: 500;
  }

  .nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
    font-size: 0.8rem;
      font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav__links a {
    color: var(--text-soft);
    position: relative;
    padding-bottom: 2px;
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 0;
    background: var(--rose);
    transition: width 250ms ease;
  }

  .nav__links a:hover::after,
  .nav__links a:focus-visible::after {
      width: 100%;
  }
</style>
