---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import ScholarlyMeta from '../../../components/seo/ScholarlyMeta.astro';
import { dateLabel, categorySlug, emify } from '../../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  return posts.map((post) => ({
    params: {
      category: categorySlug(post.data.category),
      slug: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = dateLabel(post);
const catSlug = categorySlug(post.data.category);
---
<Base
  title={`${post.data.title} — Trisha Salas`}
  description={post.data.description}
>
    {post.data.paper && <ScholarlyMeta slot="head" post={post} />}
    <Nav />
    <main>
      <article class="post-detail">
        <header class="post-detail__header">
          <p class="post-detail__meta">
            <span>{formattedDate}</span>
            <a class="post-detail__tag" href={`/blog/${catSlug}/`}>{post.data.category}</a>
          </p>
          <h1 class="post-detail__title" set:html={emify(post.data.title, post.data.titleEm)}></h1>
          {post.data.paper && (
            <p class="post-detail__byline">By {post.data.paper.authors.join(', ')}</p>
          )}
        </header>
        <div class="post-detail__body">
          <Content />
        </div>
        <p class="post-detail__back">
          <a href="/blog/">← back to the writing</a>
        </p>
      </article>
    </main>

  <Footer />
</Base>

<style>
  .post-detail__header {
    max-width: 720px;
    margin: 0 0 48px;
  }

  .post-detail__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rose-deep);
    margin: 0 0 24px;
  }

  .post-detail__tag {
    padding: 4px 10px;
    border: 1px solid var(--rose-whisper);
    border-radius: 20px;
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .post-detail__tag:hover,
  .post-detail__tag:focus-visible {
    border-color: var(--rose-deep);
    color: var(--rose);
  }

  .post-detail__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    margin: 0;
  }

  .post-detail__byline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--text-soft);
    margin: 16px 0 0;
  }

  .post-detail__body {
    max-width: 65ch;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .post-detail__body :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    margin: 48px 0 16px;
  }
  .post-detail__body :global(h3) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.375rem;
    margin: 32px 0 12px;
  }

  .post-detail__body :global(p) {
    margin: 0 0 20px;
  }

  .post-detail__body :global(blockquote) > :global(p) {
    margin: 0;
  }

  .post-detail__body :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--rose-deep);
  }
  .post-detail__body :global(a) {
    color: var(--rose-deep);
    border-bottom: 1px solid var(--rose-whisper);
  }
  .post-detail__body :global(a:hover),
  .post-detail__body :global(a:focus-visible) {
    color: var(--rose);
    border-bottom-color: var(--rose);
  }
  .post-detail__body :global(blockquote) {
    margin: 32px 0;
    padding: 4px 0 4px 24px;
    border-left: 2px solid var(--rose-whisper);
    color: var(--text-soft);
    font-style: italic;
  }
  .post-detail__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .post-detail__body :global(pre) {
    background: var(--bg-soft);
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 24px 0;
  }
  .post-detail__body :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .post-detail__body :global(ul),
  .post-detail__body :global(ol) {
    margin: 0 0 20px;
    padding-left: 24px;
  }
  .post-detail__body :global(li) { margin: 0 0 8px; }

  .post-detail__back {
    margin: 80px 0 40px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }
  .post-detail__back a {
    color: var(--rose-deep);
  }

  table {
  border-collapse: collapse;
    width: 100%;
    margin-top: 2em;
    margin-bottom: 2em;
    font-size: .875em;
    line-height: 1.71429;
}

table th,
table td {
  border-style: solid;
    border-width: 1px;
    border-color: var(--rose-deep);
    padding: 10px 20px;
    text-align: center;
}
</style>
